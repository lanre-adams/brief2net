{
  "name": "stacked_tower",
  "recipe": "stacked_tower",
  "brief": "A tall twisting tower, 30 floors, twisting 3 degrees per floor.",
  "nodes": [
    {
      "name": "floor_slab",
      "type": "box",
      "parms": {
        "sizey": 0.3
      },
      "exprs": {
        "sizex": "ch(\"../floor_width\")",
        "sizez": "ch(\"../floor_depth\")"
      },
      "note": "One floor plate"
    },
    {
      "name": "stack_floors",
      "type": "copyxform",
      "parms": {},
      "exprs": {
        "ncy": "ch(\"../floor_count\")",
        "ty": "ch(\"../floor_height\")",
        "ry": "ch(\"../twist\")"
      },
      "note": "Repeats the floor upward; Twist rotates each floor"
    },
    {
      "name": "core",
      "type": "box",
      "parms": {},
      "exprs": {
        "sizex": "ch(\"../floor_width\")*0.35",
        "sizez": "ch(\"../floor_depth\")*0.35",
        "sizey": "ch(\"../floor_count\")*ch(\"../floor_height\")",
        "ty": "ch(\"../floor_count\")*ch(\"../floor_height\")*0.5"
      },
      "note": "Central core whose height follows floors x floor height"
    },
    {
      "name": "combine",
      "type": "merge",
      "parms": {},
      "exprs": {},
      "note": "Floors + core together"
    },
    {
      "name": "OUT",
      "type": "null",
      "parms": {},
      "exprs": {},
      "note": "Final output \u2014 display flag lives here"
    }
  ],
  "connections": [
    {
      "src": "floor_slab",
      "dst": "stack_floors",
      "dst_input": 0
    },
    {
      "src": "stack_floors",
      "dst": "combine",
      "dst_input": 0
    },
    {
      "src": "core",
      "dst": "combine",
      "dst_input": 1
    },
    {
      "src": "combine",
      "dst": "OUT",
      "dst_input": 0
    }
  ],
  "controls": [
    {
      "name": "floor_count",
      "label": "Floors",
      "kind": "int",
      "default": 30,
      "min": 1,
      "max": 200,
      "drives": [
        "stack_floors.ncy",
        "core.sizey",
        "core.ty"
      ],
      "help": ""
    },
    {
      "name": "floor_height",
      "label": "Floor Height",
      "kind": "float",
      "default": 3.5,
      "min": 1,
      "max": 10,
      "drives": [
        "stack_floors.ty",
        "core.sizey",
        "core.ty"
      ],
      "help": ""
    },
    {
      "name": "floor_width",
      "label": "Floor Width",
      "kind": "float",
      "default": 20,
      "min": 2,
      "max": 100,
      "drives": [
        "floor_slab.sizex",
        "core.sizex"
      ],
      "help": ""
    },
    {
      "name": "floor_depth",
      "label": "Floor Depth",
      "kind": "float",
      "default": 20,
      "min": 2,
      "max": 100,
      "drives": [
        "floor_slab.sizez",
        "core.sizez"
      ],
      "help": ""
    },
    {
      "name": "twist",
      "label": "Twist per Floor (deg)",
      "kind": "float",
      "default": 3.0,
      "min": -45,
      "max": 45,
      "drives": [
        "stack_floors.ry"
      ],
      "help": ""
    }
  ],
  "output": "OUT",
  "assumptions": [
    "Read '30 floors' as floor_count = 30.",
    "Read '3 degrees' as twist = 3.",
    "Left at recipe defaults (brief did not say): floor_height, floor_width, floor_depth.",
    "Recipe chosen: 'Stacked / twisting tower' (keyword score 11; confidence high)."
  ]
}